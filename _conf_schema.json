{
    "restart_switch": {
        "description": "定时重启开关",
        "hint": "启用后，Astrbot将按照触发周期定时重启。可用命令 “定时重启 开/关”",
        "type": "bool",
        "default": true
    },
    "restart_cron": {
        "description": "定时重启的触发周期",
        "type": "string",
        "hint": "使用 Cron 表达式（分 时 日 月 周）定义。例如：“0 5 * * *” 表示每天 5:00 重启一次Astrbot",
        "default": "0 5 * * *"
    },
    "show_memory_info": {
        "description": "默认完成提示中显示内存使用情况",
        "hint": "仅控制默认模板中的 {memory_line}；自定义模板可直接使用其他内存占位符",
        "type": "bool",
        "default": true
    },
    "restart_prompt": {
        "description": "发起重启提示词",
        "hint": "支持 {memory}、{used_memory}、{available_memory}、{total_memory}、{memory_percent}、{start_time} 等占位符",
        "type": "text",
        "default": "正在重启 AstrBot…"
    },
    "restart_completed_prompt": {
        "description": "重启完成提示词",
        "hint": "支持 {elapsed}、{before_memory}、{after_memory}、{memory_line}、{finish_time} 等占位符，完整列表见 README",
        "type": "text",
        "default": "AstrBot 重启完成（耗时 {elapsed} 秒）{memory_line}"
    },
    "restart_cache": {
        "description": "重启缓存区",
        "type": "object",
        "invisible": true,
        "items": {
            "platform_id": {
                "description": "重启命令所在的平台",
                "type": "string"
            },
            "umo": {
                "description": "重启命令所在的会话",
                "type": "string"
            },
            "start_ts": {
                "description": "重启命令发送时间",
                "type": "float"
            },
            "memory_before": {
                "description": "重启前内存信息",
                "type": "string"
            },
            "session_id": {
                "description": "重启命令所在会话 ID",
                "type": "string"
            },
            "qqofficial_scene": {
                "description": "QQ 官方适配器会话场景",
                "type": "string"
            },
            "qqofficial_msg_id": {
                "description": "QQ 官方适配器最近消息 ID",
                "type": "string"
            }
        }
    }
}
